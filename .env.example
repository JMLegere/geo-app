# EarthNova prod deployment/admin variables
# Never pass this entire file to Flutter: it includes management secrets.
# For the production-data-connected local client, copy `.env.local.example`
# to `.env.local` instead.

# Public production values used by Railway and administrative tooling.
SUPABASE_URL=https://bfaczcsrpfcbijoaeckb.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key

# Supabase management token for CLI / GitHub Actions.
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token-here

# Railway account/workspace API token for GitHub Actions.
RAILWAY_API_TOKEN=your-railway-api-token-here

# `SUPABASE_PRODUCTION_*` names remain the GitHub-secret mapping for prod.
SUPABASE_PRODUCTION_PROJECT_REF=bfaczcsrpfcbijoaeckb
SUPABASE_PRODUCTION_DB_PASSWORD=your-production-db-password
DEPLOYMENT_ENVIRONMENT=prod
RAILWAY_PROJECT_ID=e693a14e-316c-4280-842a-6258a048d326

# Build metadata (local defaults only; CI/Railway injects real values)
BUILD_TIMESTAMP=local
APP_VERSION=dev
RAILWAY_GIT_COMMIT_SHA=
