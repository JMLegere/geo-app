# Copy to .env.local before running `mise run desktop:local`.
# This local client connects to production Supabase; gameplay changes production data.
# Flutter exposes --dart-define values to the Chrome client; use only public values.
SUPABASE_URL=https://your-production-project-ref.supabase.co
SUPABASE_ANON_KEY=your-production-public-anon-key
DEPLOYMENT_ENVIRONMENT=local

# Enables Desktop Mode controls for this production-connected local Chrome session.
DESKTOP_CONTROLS_AVAILABLE=true
DESKTOP_CONTROLS_DEFAULT=true
